{
  "name": "ocular",
  "version": "2.0.0",
  "private": true,
  "description": "Ocular — CRM e gestão para óticas. A interface fica em web/ e a API em app/.",
  "scripts": {
    "build": "npm --prefix web run build",
    "dev": "npm --prefix web run dev",
    "migrate": "php app/migrate.php",
    "smoke": "bash tests/smoke.sh",
    "format": "prettier --write \"app/**/*.php\" \"web/src/**/*.{js,jsx,css}\"",
    "format:check": "prettier --check \"app/**/*.php\" \"web/src/**/*.{js,jsx,css}\""
  },
  "devDependencies": {
    "prettier": "3.9.9",
    "@prettier/plugin-php": "0.25.0",
    "prettier-plugin-sql": "0.20.0"
  }
}
