# Acesso pela raiz do projeto (ex.: http://localhost/Otica-SD/) abre o sistema.
# Arquivos ocultos (.git, .env) e pastas de código-fonte não são servidos.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule (^|/)\. - [F,L]
  RewriteRule ^(web|docs|tests|node_modules)(/|$) - [F,L]
  RewriteRule ^$ app/public/ [R=302,L]
</IfModule>
