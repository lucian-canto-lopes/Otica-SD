{
  "plugins": ["@prettier/plugin-php", "prettier-plugin-sql"],
  "tabWidth": 2,
  "singleQuote": true,
  "printWidth": 100,
  "overrides": [
    {
      "files": "*.php",
      "options": { "tabWidth": 4, "phpVersion": "8.3" }
    },
    {
      "files": "*.sql",
      "options": { "language": "mysql" }
    }
  ]
}
